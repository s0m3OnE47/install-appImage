#!/usr/bin/env python3

import argparse
import os
import shutil
import subprocess
import sys
from pathlib import Path


def check_root():
    if os.geteuid() != 0:
        sys.exit("Error: This script must be run as root (use sudo).")


def replace_executable(source: Path, destination: Path) -> None:
    """Install source over destination even if destination is currently running.

    Direct overwrite (e.g. shutil.copy2) raises ETXTBSY when the target binary
    is mapped for execution. Copy to a same-dir tempfile, then os.replace().
    """
    destination.parent.mkdir(parents=True, exist_ok=True)
    tmp = destination.with_name(f".{destination.name}.tmp.{os.getpid()}")
    try:
        shutil.copy2(source, tmp)
        tmp.chmod(0o755)
        os.replace(tmp, destination)
    finally:
        if tmp.exists():
            tmp.unlink(missing_ok=True)


def check_zenity():
    if shutil.which("zenity") is None:
        sys.exit("Error: Zenity is not installed. Install it with: sudo apt install zenity")


def zenity_entry(prompt):
    try:
        result = subprocess.run(
            ["zenity", "--entry", "--title=AppImage Installer", f"--text={prompt}"],
            capture_output=True, text=True, check=True,
        )
        name = result.stdout.strip()
        if not name:
            sys.exit("Error: No application name provided.")
        return name
    except subprocess.CalledProcessError:
        sys.exit("Cancelled by user.")


def zenity_file_selection():
    try:
        result = subprocess.run(
            [
                "zenity", "--file-selection",
                "--title=Select an icon for the application",
                "--file-filter=Image files | *.png *.svg *.xpm *.ico",
            ],
            capture_output=True, text=True, check=True,
        )
        path = result.stdout.strip()
        if not path:
            sys.exit("Error: No icon selected.")
        return Path(path)
    except subprocess.CalledProcessError:
        sys.exit("Cancelled by user.")


def get_real_user():
    return os.environ.get("SUDO_USER", os.getlogin())


def get_real_user_home():
    sudo_user = os.environ.get("SUDO_USER")
    if sudo_user:
        return Path(f"/home/{sudo_user}")
    return Path.home()


def chown_recursive(path: Path, user: str):
    shutil.chown(path, user=user, group=user)
    if path.is_dir():
        for child in path.rglob("*"):
            shutil.chown(child, user=user, group=user)


def assert_safe_app_name(name: str) -> str:
    if not name:
        sys.exit("Error: Application name cannot be empty.")
    if "/" in name or name in (".", ".."):
        sys.exit("Error: Application name must not be '.' or '..' or contain '/'.")
    return name


def update_zsh_path(app_dir: Path):
    zshrc = get_real_user_home() / ".zshrc"
    export_line = f'export PATH="{app_dir}:$PATH"'

    if zshrc.exists():
        content = zshrc.read_text()
        if export_line in content:
            return
    else:
        content = ""

    with open(zshrc, "a") as f:
        f.write(f"\n{export_line}\n")
    print(f"Added {app_dir} to $PATH in {zshrc}")


def remove_zsh_path(app_dir: Path):
    zshrc = get_real_user_home() / ".zshrc"
    export_line = f'export PATH="{app_dir}:$PATH"'

    if not zshrc.is_file():
        return

    text = zshrc.read_text()
    lines = text.splitlines()
    if export_line not in lines:
        return

    new_lines = [ln for ln in lines if ln != export_line]
    ending = "\n" if text.endswith("\n") else ""
    zshrc.write_text("\n".join(new_lines) + ending)
    print(f"Removed {app_dir} from $PATH in {zshrc}")


def find_existing_icon(app_dir: Path, name: str) -> Path | None:
    """Return an icon path under app_dir from the .desktop file or standard filenames."""
    desktop_path = Path(f"/usr/share/applications/{name}.desktop")
    if desktop_path.is_file():
        for line in desktop_path.read_text().splitlines():
            line = line.strip()
            if not line.startswith("Icon="):
                continue
            raw = line[5:].strip()
            if not raw or raw.startswith("#"):
                break
            p = Path(raw)
            if not p.is_absolute():
                p = app_dir / p
            if p.is_file():
                try:
                    p.resolve().relative_to(app_dir.resolve())
                    return p
                except ValueError:
                    pass
            break
    for ext in (".png", ".svg", ".xpm", ".ico"):
        candidate = app_dir / f"{name}{ext}"
        if candidate.is_file():
            return candidate
    return None


def desktop_entry_display_name(name: str) -> str:
    """Human-facing launcher title for Name=: capitalize the start of each word; keep other letters as given."""
    s = name.strip()
    if not s:
        return s
    return " ".join((w[0].upper() + w[1:]) if w else w for w in s.split())


def write_desktop_entry(
    name: str,
    dest_appimage: Path,
    icon_dest: Path,
    desktop_path: Path,
    sandbox: bool,
):
    exec_line = f"Exec={dest_appimage}\n" if sandbox else f"Exec={dest_appimage} --no-sandbox\n"
    desktop_entry = (
        "[Desktop Entry]\n"
        "Type=Application\n"
        f"Name={desktop_entry_display_name(name)}\n"
        f"{exec_line}"
        f"Icon={icon_dest}\n"
        "Terminal=false\n"
        f"StartupWMClass={name.lower()}\n"
        "Categories=Utility;\n"
    )
    desktop_path.write_text(desktop_entry)


def update_desktop_database():
    if shutil.which("update-desktop-database") is None:
        return
    subprocess.run(["update-desktop-database"], check=True)
    print("Ran update-desktop-database")


def run_uninstall(name_raw: str) -> None:
    name = assert_safe_app_name(name_raw.strip())
    app_dir = Path("/opt") / name
    desktop_path = Path(f"/usr/share/applications/{name}.desktop")

    had_dir = app_dir.is_dir()
    had_desktop = desktop_path.is_file()

    if not had_dir and not had_desktop:
        sys.exit(
            f"Error: Nothing to remove for '{name}' "
            f"(no {app_dir} and no {desktop_path})."
        )

    if had_dir:
        shutil.rmtree(app_dir)
        print(f"Removed {app_dir}")

    if had_desktop:
        desktop_path.unlink()
        print(f"Removed {desktop_path}")

    remove_zsh_path(app_dir)
    print(f"\n'{name}' uninstalled.")


def main():
    parser = argparse.ArgumentParser(
        description=(
            "Install a Linux AppImage under /opt/<name>, add a .desktop launcher, "
            "and append the app directory to the real user's ~/.zshrc PATH; or uninstall "
            "given name (remove /opt/<name> and its .desktop file). "
            "If /opt/<name> already exists (same --name or dialog name), only the "
            "AppImage file is replaced; the icon is reused when present, otherwise "
            "you are prompted to pick one. "
            "Must be run with sudo; uses Zenity dialogs for the app name (if not given with --name) "
            "and for choosing an icon when needed. By default the .desktop Exec line appends "
            "--no-sandbox; use --sandbox to launch the AppImage without that flag."
        ),
        epilog=(
            "Usage flow (new install):\n"
            "  1. sudo install-appimage /path/to/app.AppImage\n"
            "     (Install the script to /usr/local/bin first: sudo make install — see README if sudo "
            "reports command not found.)\n"
            "  2. If --name is omitted, enter the display name in the dialog.\n"
            "  3. Pick a PNG, SVG, XPM, or ICO file for the launcher icon.\n"
            "  4. The AppImage is copied to /opt/<name>/, owned by the user who invoked sudo.\n"
            "\n"
            "Updating: run again with the new .AppImage file and the same name (--name or dialog). "
            "The script overwrites /opt/<name>/<name>, fixes permissions and ownership, "
            "refreshes the .desktop entry, and only asks for an icon if none is found under /opt/<name>.\n"
            "\n"
            "Use --sandbox so the menu launcher runs only the AppImage (no --no-sandbox). "
            "The default is to add --no-sandbox for Electron-style apps that need it.\n"
            "\n"
            "Uninstall: sudo install-appimage --uninstall <name> removes /opt/<name>, "
            "/usr/share/applications/<name>.desktop, and the matching PATH line from ~/.zshrc if present.\n"
            "\n"
            "Requires: root, Zenity when a dialog is needed (e.g. apt install zenity), "
            "and a graphical session for those dialogs."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "appimage",
        nargs="?",
        help="Path to the .AppImage file to install (not used with --uninstall)",
    )
    parser.add_argument(
        "--name",
        metavar="NAME",
        help="Application name and install folder under /opt",
    )
    parser.add_argument(
        "--sandbox",
        action="store_true",
        help="Do not append --no-sandbox to the .desktop Exec command (default: add --no-sandbox)",
    )
    parser.add_argument(
        "--uninstall",
        metavar="NAME",
        help="Remove /opt/NAME, /usr/share/applications/NAME.desktop, and the matching ~/.zshrc PATH line",
    )
    args = parser.parse_args()

    if args.uninstall is not None:
        if args.appimage is not None:
            parser.error("Do not pass an AppImage path when using --uninstall.")
        if args.name is not None:
            parser.error("--name is not used with --uninstall (use --uninstall NAME).")
        if args.sandbox:
            parser.error("--sandbox is not used with --uninstall.")
        check_root()
        run_uninstall(args.uninstall)
        return

    if args.appimage is None:
        parser.error("the following arguments are required: appimage")

    check_root()

    appimage_path = Path(args.appimage).resolve()
    if not appimage_path.is_file():
        sys.exit(f"Error: '{appimage_path}' is not a valid file.")

    if args.name:
        name = assert_safe_app_name(args.name)
    else:
        check_zenity()
        name = assert_safe_app_name(zenity_entry("Enter a name for the application:"))

    app_dir = Path(f"/opt/{name}")
    dest_appimage = app_dir / name
    desktop_path = Path(f"/usr/share/applications/{name}.desktop")
    real_user = get_real_user()

    if app_dir.is_dir():
        replace_executable(appimage_path, dest_appimage)
        print(f"Updated AppImage at {dest_appimage}")

        legacy_appimage = app_dir / f"{name}.AppImage"
        if legacy_appimage.is_file():
            legacy_appimage.unlink()
            print(f"Removed legacy {legacy_appimage}")

        icon_dest = find_existing_icon(app_dir, name)
        if icon_dest is None:
            check_zenity()
            icon_src = zenity_file_selection()
            icon_dest = app_dir / f"{name}{icon_src.suffix}"
            shutil.copy2(icon_src, icon_dest)
            print(f"Icon copied to {icon_dest}")
        else:
            print(f"Keeping existing icon at {icon_dest}")

        chown_recursive(app_dir, real_user)
        print(f"Ownership set to {real_user} for {app_dir}")

        write_desktop_entry(name, dest_appimage, icon_dest, desktop_path, args.sandbox)
        print(f"Updated desktop entry at {desktop_path}")

        update_zsh_path(app_dir)
        update_desktop_database()
        print(f"\n'{name}' AppImage updated successfully.")
        return

    check_zenity()
    app_dir.mkdir(parents=True, exist_ok=True)

    replace_executable(appimage_path, dest_appimage)
    print(f"Installed AppImage to {dest_appimage}")

    icon_src = zenity_file_selection()
    icon_dest = app_dir / f"{name}{icon_src.suffix}"
    shutil.copy2(icon_src, icon_dest)
    print(f"Icon copied to {icon_dest}")

    chown_recursive(app_dir, real_user)
    print(f"Ownership set to {real_user} for {app_dir}")

    write_desktop_entry(name, dest_appimage, icon_dest, desktop_path, args.sandbox)
    print(f"Created desktop entry at {desktop_path}")

    update_zsh_path(app_dir)
    update_desktop_database()

    print(f"\n'{name}' installed successfully.")


if __name__ == "__main__":
    main()
